/*
========================================================================================
    Cloud development config — reduced resources for stub runs on small VMs
========================================================================================
    Use with -stub-run on machines with ~4 CPUs and ~16 GB RAM:

        nextflow run main.nf -profile test_design_rfdiffusion_v3 -stub-run -c conf/cloud_dev.config

    Not intended for production GPU runs.
========================================================================================
*/

process {
    cpus   = 2
    memory = '4 GB'

    withLabel: process_high_gpu   { cpus = 2; memory = '4 GB' }
    withLabel: process_medium_gpu { cpus = 2; memory = '4 GB' }
    withLabel: process_high       { cpus = 2; memory = '4 GB' }
    withLabel: process_medium     { cpus = 2; memory = '4 GB' }

    withName: RFDIFFUSION_V3_RUN       { cpus = 2; memory = '4 GB' }
    withName: PROTEINA_COMPLEXA_DESIGN { cpus = 2; memory = '4 GB' }
    withName: PROTEINMPNN_OPTIMIZE     { cpus = 2; memory = '4 GB' }
    withName: BOLTZ2_REFOLD            { cpus = 2; memory = '4 GB' }
    withName: FOLDSEEK_SEARCH          { cpus = 2; memory = '4 GB' }
}
