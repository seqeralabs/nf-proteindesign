/*
========================================================================================
    Nextflow config file for testing DESIGN mode - RFdiffusion
========================================================================================
    Tests the RFdiffusion backbone design path (v3 by default) using the same
    Nipah Glycoprotein target as the existing Boltzgen test profiles.

    Defaults to RFdiffusion3 (rfdiffusion_v3). To test v1 instead, add:
        --design_tool rfdiffusion_v1

    For quick pipeline-logic validation without GPU, use stub-run mode:
        nextflow run main.nf -profile test_design_rfdiffusion,docker -stub-run

    For a full GPU run (requires GPU node and downloaded model weights):
        nextflow run main.nf -profile test_design_rfdiffusion,docker

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile - Design Mode (RFdiffusion)'
    config_profile_description = 'Test dataset for RFdiffusion backbone design using Nipah Glycoprotein target'

    // Input data
    input       = "${projectDir}/assets/test_data/samplesheet_design_rfdiffusion.csv"

    // Select RFdiffusion3 by default; override with --design_tool rfdiffusion_v1 for v1
    design_tool = 'rfdiffusion_v3'

    // Reduced downstream parameters for faster testing (same as other test profiles)
    mpnn_num_seq_per_target    = 2
    boltz2_predict_affinity    = false
    boltz2_use_msa             = false
    boltz2_num_recycling       = 1
    boltz2_num_diffusion       = 1
    run_foldseek               = false

    // Output
    outdir      = './results_test_design_rfdiffusion'
}
